diff --git a/applets/batterymonitor/plugin/batterychargecontrol.cpp b/applets/batterymonitor/plugin/batterychargecontrol.cpp
new file mode 100644
index 000000000..07c35f8cf
--- /dev/null
+++ b/applets/batterymonitor/plugin/batterychargecontrol.cpp
@@ -0,0 +1,105 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "batterychargecontrol.h"
+
+#include "batterymonitor_debug.h"
+
+#include <KAuth/Action>
+#include <KAuth/ExecuteJob>
+
+BatteryChargeControl::BatteryChargeControl(QObject *parent)
+    : QObject(parent)
+{
+    refresh();
+}
+
+bool BatteryChargeControl::isSupported() const
+{
+    return m_supported;
+}
+
+bool BatteryChargeControl::isEnabled() const
+{
+    return m_enabled;
+}
+
+bool BatteryChargeControl::isBusy() const
+{
+    return m_busy;
+}
+
+void BatteryChargeControl::setSupported(bool supported)
+{
+    if (m_supported == supported) {
+        return;
+    }
+    m_supported = supported;
+    Q_EMIT supportedChanged(m_supported);
+}
+
+void BatteryChargeControl::updateEnabled(bool enabled)
+{
+    if (m_enabled == enabled) {
+        return;
+    }
+    m_enabled = enabled;
+    Q_EMIT enabledChanged(m_enabled);
+}
+
+void BatteryChargeControl::setBusy(bool busy)
+{
+    if (m_busy == busy) {
+        return;
+    }
+    m_busy = busy;
+    Q_EMIT busyChanged(m_busy);
+}
+
+void BatteryChargeControl::refresh()
+{
+    KAuth::Action action(QStringLiteral("org.kde.powerdevil.chargethresholdhelper.getconservationmode"));
+    action.setHelperId(QStringLiteral("org.kde.powerdevil.chargethresholdhelper"));
+    KAuth::ExecuteJob *job = action.execute();
+    connect(job, &KJob::result, this, [this, job] {
+        if (job->error()) {
+            setSupported(false);
+            return;
+        }
+        setSupported(true);
+        updateEnabled(job->data().value(QStringLiteral("batteryConservationModeEnabled")).toBool());
+    });
+    job->start();
+}
+
+void BatteryChargeControl::setEnabled(bool enabled)
+{
+    if (!m_supported || m_busy || m_enabled == enabled) {
+        return;
+    }
+
+    const bool previous = m_enabled;
+    updateEnabled(enabled);
+    setBusy(true);
+
+    KAuth::Action action(QStringLiteral("org.kde.powerdevil.chargethresholdhelper.setconservationmode"));
+    action.setHelperId(QStringLiteral("org.kde.powerdevil.chargethresholdhelper"));
+    action.addArgument(QStringLiteral("batteryConservationModeEnabled"), enabled);
+    KAuth::ExecuteJob *job = action.execute();
+    connect(job, &KJob::result, this, [this, job, previous] {
+        setBusy(false);
+        if (job->error()) {
+            qCDebug(APPLETS::BATTERYMONITOR) << "Failed to set conservation mode:" << job->errorText();
+            updateEnabled(previous);
+            return;
+        }
+        // Re-read to confirm the value actually stuck.
+        refresh();
+    });
+    job->start();
+}
+
+#include "moc_batterychargecontrol.cpp"
diff --git a/applets/batterymonitor/plugin/batterychargecontrol.h b/applets/batterymonitor/plugin/batterychargecontrol.h
new file mode 100644
index 000000000..3445aae84
--- /dev/null
+++ b/applets/batterymonitor/plugin/batterychargecontrol.h
@@ -0,0 +1,45 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#pragma once
+
+#include <QObject>
+#include <qqmlregistration.h>
+
+class BatteryChargeControl : public QObject
+{
+    Q_OBJECT
+    QML_ELEMENT
+
+    Q_PROPERTY(bool supported READ isSupported NOTIFY supportedChanged)
+    Q_PROPERTY(bool enabled READ isEnabled WRITE setEnabled NOTIFY enabledChanged)
+    Q_PROPERTY(bool busy READ isBusy NOTIFY busyChanged)
+
+public:
+    explicit BatteryChargeControl(QObject *parent = nullptr);
+
+    bool isSupported() const;
+    bool isEnabled() const;
+    bool isBusy() const;
+
+public Q_SLOTS:
+    void setEnabled(bool enabled);
+
+Q_SIGNALS:
+    void supportedChanged(bool supported);
+    void enabledChanged(bool enabled);
+    void busyChanged(bool busy);
+
+private:
+    void refresh();
+    void setSupported(bool supported);
+    void updateEnabled(bool enabled);
+    void setBusy(bool busy);
+
+    bool m_supported = false;
+    bool m_enabled = false;
+    bool m_busy = false;
+};
