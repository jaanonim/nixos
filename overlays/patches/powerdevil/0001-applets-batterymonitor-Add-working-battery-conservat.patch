From 2b26a578ac6cfb114b35dfbac869508ac146fbc6 Mon Sep 17 00:00:00 2001
From: jaanonim <mat8mro@gmail.com>
Date: Tue, 6 Oct 2026 13:59:00 +0200
Subject: [PATCH 1/2] applets/batterymonitor: Add working battery conservation
 mode switch

Wire the BatteryItem charge-limit switch to the chargethresholdhelper
KAuth helper via a new BatteryChargeControl, same path the KCM uses.
---
 applets/batterymonitor/BatteryItem.qml        |  21 ++++
 applets/batterymonitor/PopupDialog.qml        |  11 ++
 applets/batterymonitor/main.qml               |  11 ++
 applets/batterymonitor/plugin/CMakeLists.txt  |   2 +
 .../plugin/batterychargecontrol.cpp           | 105 ++++++++++++++++++
 .../plugin/batterychargecontrol.h             |  45 ++++++++
 6 files changed, 195 insertions(+)
 create mode 100644 applets/batterymonitor/plugin/batterychargecontrol.cpp
 create mode 100644 applets/batterymonitor/plugin/batterychargecontrol.h

diff --git a/applets/batterymonitor/BatteryItem.qml b/applets/batterymonitor/BatteryItem.qml
index 0b194440e..cad23a7f2 100644
--- a/applets/batterymonitor/BatteryItem.qml
+++ b/applets/batterymonitor/BatteryItem.qml
@@ -45,6 +45,12 @@ PlasmaComponents3.ItemDelegate {
 
     property int chargeStopThreshold: 0
 
+    property bool batteryConservationModeSupported: false
+    property bool batteryConservationModeEnabled: false
+    property bool batteryConservationModeBusy: false
+
+    signal conservationModeChangeRequested(bool enabled)
+
     // Existing instance of a slider to use as a reference to calculate extra
     // margins for a progress bar, so that the row of labels on top of it
     // could visually look as if it were on the same distance from the bar as
@@ -229,6 +235,21 @@ PlasmaComponents3.ItemDelegate {
                 }
             }
 
+            PlasmaComponents3.Switch {
+                id: batteryConservationModeSwitch
+                Layout.fillWidth: true
+                Layout.topMargin: Kirigami.Units.smallSpacing
+
+                visible: root.batteryConservationModeSupported && root.batteryIsPowerSupply
+                checked: root.batteryConservationModeEnabled
+                enabled: !root.batteryConservationModeBusy
+                text: i18nc("@action:button", "Limit the maximum battery charge")
+
+                Accessible.onPressAction: toggled()
+
+                onToggled: root.conservationModeChangeRequested(checked)
+            }
+
             InhibitionHint {
                 Layout.fillWidth: true
                 Layout.topMargin: Kirigami.Units.smallSpacing
